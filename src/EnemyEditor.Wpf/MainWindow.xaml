<Window x:Class="EnemyEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Border Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="Редактор противников" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"
                           Text="Каркас приложения готов." />
            </StackPanel>
        </Border>
    </Grid>
</Window>

